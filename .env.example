# Esempio di configurazione locale per Docker Compose: copiare in `.env`.
# Nessuna credenziale: questa fase non ha autenticazione né esposizione pubblica.
#
# Porta MCP pubblicata solo sul loopback dell'host (127.0.0.1).
OFFERTE_MCP_PORT=8000
# Directory host e nome del CSV dei parametri montati nel job ETL. Il nome
# porta la data di riferimento e deve restare `PO_Parametri_..._AAAAMMGG.csv`.
# Sarà sostituito dal download automatico in un obiettivo successivo.
OFFERTE_PARAMETRI_DIR=./docs
OFFERTE_PARAMETRI_NOME=PO_Parametri_Mercato_Libero_E_20261014.csv
